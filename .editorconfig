# Правила отступов и переводов строк для любого редактора.
# GoLand, VS Code, Vim и прочие читают этот файл сами — ничего настраивать не надо.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# В Go отступы — только табы, так требует gofmt
[*.go]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
