# Шаблон окружения. Рабочий файл .env создаётся из него: cp .env.example .env
# .env в git не попадает (см. .gitignore) — там настоящие пароли, здесь только пример.
#
# Порты выбраны вне диапазонов, занятых другими проектами на этой машине:
#   trade — 5433 (postgres), 6389 (redis), 9092 (kafka), 8085 (kafka-ui)
#   mcp   — 5434 (postgres), 6399 (redis), 3000 (postgrest), 8091 (swagger)

# ---------- PostgreSQL (этап 1) ----------
# Порт наружу и доступы самого контейнера postgres
POSTGRES_PORT=5440
POSTGRES_DB=forno
POSTGRES_USER=forno
POSTGRES_PASSWORD=change_me_local_only

# Единственное, что читает код приложения — строка подключения целиком.
# Здесь она для инструментов с хоста (psql, GUI-клиент): localhost:5440.
# Код и тесты бегут в контейнере tools, и compose подменяет им DSN
# на внутрисетевой postgres:5432 — см. docker-compose.yml.
POSTGRES_DSN=postgres://forno:change_me_local_only@localhost:5440/forno?sslmode=disable

# ---------- Redis (этап 9) ----------
# REDIS_PORT=6400

# ---------- Kafka (этап 8) ----------
# KAFKA_PORT=9094

# Параметры самих сервисов (адреса, таймауты, лимиты) переедут сюда на этапе 7,
# когда появится конфиг на YAML + cleanenv с профилями local / production / docker.
