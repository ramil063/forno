# Образ для разработки: Go + все инструменты генерации и проверки.
# Версия Go задаётся здесь одной строкой — это и есть способ менять версию.
ARG GO_VERSION=1.27.1
FROM golang:${GO_VERSION}-alpine3.24

ARG UID=1000
ARG GID=1000

# build-base нужен для -race: детектор гонок требует CGO и компилятор C
RUN apk add --no-cache git make bash curl build-base

# Пользователь с тем же uid/gid, что и на хосте.
# Без этого air, buf и mockery создают файлы от root, и ты не можешь их править.
RUN addgroup -g ${GID} dev \
 && adduser -D -u ${UID} -G dev -h /home/dev dev \
 && mkdir -p /work \
 && chown dev:dev /work

# GOBIN намеренно вне GOPATH: в compose на /home/dev/go/pkg/mod навешен том с кешем
# модулей, а том маскирует всё, что лежит в образе под точкой монтирования. Держи
# бинарники вне тома — тогда обновление инструмента в образе видно без сноса кеша.
ENV GOPATH=/home/dev/go \
    GOMODCACHE=/home/dev/go/pkg/mod \
    GOCACHE=/home/dev/.cache/go-build \
    GOBIN=/home/dev/bin \
    PATH=/home/dev/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin \
    CGO_ENABLED=1

RUN mkdir -p /home/dev/bin /home/dev/go/pkg/mod /home/dev/.cache/go-build \
 && chown -R dev:dev /home/dev

USER dev
WORKDIR /work

# Инструменты ставятся от имени dev, чтобы их можно было обновлять
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
 && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest \
 && go install github.com/bufbuild/buf/cmd/buf@latest \
 && go install github.com/vektra/mockery/v2@latest \
 && go install github.com/air-verse/air@latest \
 && go install github.com/pressly/goose/v3/cmd/goose@latest

# golangci-lint отдельным слоем: если он сломается, предыдущий кеш сохранится
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

CMD ["sleep", "infinity"]
